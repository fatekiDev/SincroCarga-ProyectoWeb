# --- Conexión a PostgreSQL ---
# Producción (Render + Neon): define SOLO DATABASE_URL con la cadena *pooled* de Neon,
# p. ej. postgresql://USUARIO:CLAVE@HOST/BD?sslmode=require  (nunca la subas a Git).
# Si DATABASE_URL está definida, se ignoran las variables PG* de abajo.
# DATABASE_URL=

# Desarrollo local (PostgreSQL propio):
PGHOST=localhost
PGPORT=5432
PGDATABASE=bd_grupo2_sincrochiloe
PGUSER=postgres
PGPASSWORD=replace_with_your_local_password
# Origen(es) permitido(s) para CORS, separados por coma. En producción: el dominio exacto de Vercel, sin "/" final.
FRONTEND_ORIGINS=http://localhost:5173
# Render inyecta PORT automáticamente; solo se fija en local.
PORT=3000
SINCROCARGA_COMMISSION_PERCENT=10
# Solo para crear una cuenta administrativa mediante `npm run admin:create`.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=replace_with_a_unique_12_character_password
