"transportista" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#2FA37A"><TR><TD COLSPAN="4" BGCOLOR="#2FA37A"><FONT COLOR="white" POINT-SIZE="13"><B>transportista</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_transportista"><FONT POINT-SIZE="9" COLOR="#2FA37A"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_transportista"><B>id_transportista</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_transportista"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_rut_empresa"><FONT POINT-SIZE="9" COLOR="#2FA37A"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="rut_empresa">rut_empresa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(12)</FONT></TD><TD PORT="r_rut_empresa"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_razon_social"> </TD><TD ALIGN="LEFT" PORT="razon_social">razon_social</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(150)</FONT></TD><TD PORT="r_razon_social"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_email"><FONT POINT-SIZE="9" COLOR="#2FA37A"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(150)</FONT></TD><TD PORT="r_email"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_telefono"> </TD><TD ALIGN="LEFT" PORT="telefono">telefono</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_telefono"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_direccion"> </TD><TD ALIGN="LEFT" PORT="direccion">direccion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(200)</FONT></TD><TD PORT="r_direccion"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_registro"> </TD><TD ALIGN="LEFT" PORT="fecha_registro">fecha_registro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_registro"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_activo"> </TD><TD ALIGN="LEFT" PORT="activo">activo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">boolean</FONT></TD><TD PORT="r_activo"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado_verificacion"> </TD><TD ALIGN="LEFT" PORT="estado_verificacion">estado_verificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado_verificacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_motivo_revision"> </TD><TD ALIGN="LEFT" PORT="motivo_revision">motivo_revision</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(500)</FONT></TD><TD PORT="r_motivo_revision"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_revision"> </TD><TD ALIGN="LEFT" PORT="fecha_revision">fecha_revision</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_revision"> </TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: email con formato válido<BR ALIGN="LEFT"/>CHK: estado_verificacion ∈ {Pendiente,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Verificado, Rechazado}<BR ALIGN="LEFT"/>CHK: rut_empresa con formato chileno<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"usuario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C94F5D"><TR><TD COLSPAN="4" BGCOLOR="#C94F5D"><FONT COLOR="white" POINT-SIZE="13"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_usuario"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_usuario"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_usuario"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_email"> </TD><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(150)</FONT></TD><TD PORT="r_email"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_password_hash"> </TD><TD ALIGN="LEFT" PORT="password_hash">password_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">text</FONT></TD><TD PORT="r_password_hash"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_rol"> </TD><TD ALIGN="LEFT" PORT="rol">rol</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_rol"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_cliente_id"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="cliente_id">cliente_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_cliente_id"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_transportista_id"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="transportista_id">transportista_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_transportista_id"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_registro"> </TD><TD ALIGN="LEFT" PORT="fecha_registro">fecha_registro</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_registro"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_activo"> </TD><TD ALIGN="LEFT" PORT="activo">activo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">boolean</FONT></TD><TD PORT="r_activo"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_nombre_mostrar"> </TD><TD ALIGN="LEFT" PORT="nombre_mostrar">nombre_mostrar</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(120)</FONT></TD><TD PORT="r_nombre_mostrar"> </TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">UNIQUE IDX (lower(email))<BR ALIGN="LEFT"/>CHK: email con formato válido<BR ALIGN="LEFT"/>CHK: perfil coherente con rol<BR ALIGN="LEFT"/>&nbsp;&nbsp;(cliente→cliente_id,<BR ALIGN="LEFT"/>&nbsp;&nbsp;camionero→transportista_id, admin→ninguno)<BR ALIGN="LEFT"/>CHK: rol ∈ {cliente, camionero, admin}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"usuario_sesion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C94F5D"><TR><TD COLSPAN="4" BGCOLOR="#C94F5D"><FONT COLOR="white" POINT-SIZE="13"><B>usuario_sesion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_sesion"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_sesion"><B>id_sesion</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bigint</FONT></TD><TD PORT="r_id_sesion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_usuario_id"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="usuario_id">usuario_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_usuario_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_token_hash"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="token_hash">token_hash</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">char(64)</FONT></TD><TD PORT="r_token_hash"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_creacion"> </TD><TD ALIGN="LEFT" PORT="fecha_creacion">fecha_creacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_creacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_expiracion"> </TD><TD ALIGN="LEFT" PORT="fecha_expiracion">fecha_expiracion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_expiracion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: fecha_expiracion &gt; fecha_creacion<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"viaje" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>viaje</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_viaje"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_viaje"><B>id_viaje</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_viaje"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_match_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="match_id">match_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_match_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_inicio"> </TD><TD ALIGN="LEFT" PORT="fecha_inicio">fecha_inicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_inicio"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_fin"> </TD><TD ALIGN="LEFT" PORT="fecha_fin">fecha_fin</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_fin"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tarifa_final"> </TD><TD ALIGN="LEFT" PORT="tarifa_final">tarifa_final</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_tarifa_final"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_camion_id_actual"> </TD><TD ALIGN="LEFT" PORT="camion_id_actual">camion_id_actual</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_camion_id_actual"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_chofer_id_actual"> </TD><TD ALIGN="LEFT" PORT="chofer_id_actual">chofer_id_actual</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_chofer_id_actual"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: estado=&#x27;Completado&#x27; ⇒ fecha_fin ≠ NULL<BR ALIGN="LEFT"/>CHK: estado ∈ {En Progreso, Completado,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Cancelado, Incidencia}<BR ALIGN="LEFT"/>CHK: (fecha_fin = NULL) OR (fecha_fin &gt;<BR ALIGN="LEFT"/>&nbsp;&nbsp;fecha_inicio)<BR ALIGN="LEFT"/>CHK: tarifa_final &gt;= 0<BR ALIGN="LEFT"/>EXCL: (camion_id_actual WITH =,<BR ALIGN="LEFT"/>&nbsp;&nbsp;tsrange(fecha_inicio, COALESCE(fecha_fin,<BR ALIGN="LEFT"/>&nbsp;&nbsp;&#x27;infinity&#x27;)) WITH &amp;&amp;) WHERE (((estado)&lt;&gt;<BR ALIGN="LEFT"/>&nbsp;&nbsp;&#x27;Cancelado&#x27;))<BR ALIGN="LEFT"/>EXCL: (chofer_id_actual WITH =,<BR ALIGN="LEFT"/>&nbsp;&nbsp;tsrange(fecha_inicio, COALESCE(fecha_fin,<BR ALIGN="LEFT"/>&nbsp;&nbsp;&#x27;infinity&#x27;)) WITH &amp;&amp;) WHERE (((estado)&lt;&gt;<BR ALIGN="LEFT"/>&nbsp;&nbsp;&#x27;Cancelado&#x27;))<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
