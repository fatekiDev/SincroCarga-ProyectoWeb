"tarifa_referencial" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#5B8DEF"><TR><TD COLSPAN="4" BGCOLOR="#5B8DEF"><FONT COLOR="white" POINT-SIZE="13"><B>tarifa_referencial</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_tarifa"><FONT POINT-SIZE="9" COLOR="#5B8DEF"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_tarifa"><B>id_tarifa</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_tarifa"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_ruta_id"><FONT POINT-SIZE="9" COLOR="#5B8DEF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ruta_id">ruta_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_ruta_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tipo_carga_id"><FONT POINT-SIZE="9" COLOR="#5B8DEF"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="tipo_carga_id">tipo_carga_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_tipo_carga_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_valor"> </TD><TD ALIGN="LEFT" PORT="valor">valor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_valor"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_vigencia_desde"> </TD><TD ALIGN="LEFT" PORT="fecha_vigencia_desde">fecha_vigencia_desde</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">date</FONT></TD><TD PORT="r_fecha_vigencia_desde"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_vigencia_hasta"> </TD><TD ALIGN="LEFT" PORT="fecha_vigencia_hasta">fecha_vigencia_hasta</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">date</FONT></TD><TD PORT="r_fecha_vigencia_hasta"> </TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: (fecha_vigencia_hasta = NULL) OR<BR ALIGN="LEFT"/>&nbsp;&nbsp;(fecha_vigencia_hasta &gt; fecha_vigencia_desde)<BR ALIGN="LEFT"/>CHK: valor &gt;= 0<BR ALIGN="LEFT"/>EXCL: (ruta_id WITH =, tipo_carga_id WITH =,<BR ALIGN="LEFT"/>&nbsp;&nbsp;daterange(fecha_vigencia_desde,<BR ALIGN="LEFT"/>&nbsp;&nbsp;COALESCE(fecha_vigencia_hasta, &#x27;infinity&#x27;),<BR ALIGN="LEFT"/>&nbsp;&nbsp;&#x27;[)&#x27;) WITH &amp;&amp;)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"tipo_carga" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#5B8DEF"><TR><TD COLSPAN="4" BGCOLOR="#5B8DEF"><FONT COLOR="white" POINT-SIZE="13"><B>tipo_carga</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_tipo_carga"><FONT POINT-SIZE="9" COLOR="#5B8DEF"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_tipo_carga"><B>id_tipo_carga</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_tipo_carga"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_nombre"><FONT POINT-SIZE="9" COLOR="#5B8DEF"><B>UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="nombre">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(50)</FONT></TD><TD PORT="r_nombre"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_requiere_refrigeracion"> </TD><TD ALIGN="LEFT" PORT="requiere_refrigeracion">requiere_refrigeracion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">boolean</FONT></TD><TD PORT="r_requiere_refrigeracion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_es_peligrosa"> </TD><TD ALIGN="LEFT" PORT="es_peligrosa">es_peligrosa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">boolean</FONT></TD><TD PORT="r_es_peligrosa"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_descripcion"> </TD><TD ALIGN="LEFT" PORT="descripcion">descripcion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(255)</FONT></TD><TD PORT="r_descripcion"> </TD></TR></TABLE>>];
