subgraph cluster_leg { label="Leyenda"; fontsize=12; style=rounded; color="#BBBBBB";leg [shape=plain, label=<<TABLE BORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><B>PK</B> clave primaria · <B>FK</B> clave foránea · <B>UQ</B> único · <B>NN</B> NOT NULL</TD></TR><TR><TD ALIGN="LEFT">Notación pata de gallo: ─┼ obligatorio (1) · ─○┼ opcional (0..1) · ─○&lt; cero o muchos · ═ 1:1</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#D1344A"><B>DEL CASCADE</B></FONT> borra hijos · <FONT COLOR="#1E5FD8"><B>DEL RESTRICT</B></FONT> impide borrar al padre</TD></TR><TR><TD ALIGN="LEFT">CHK = CHECK · EXCL = EXCLUDE (no solapamiento, requiere btree_gist)</TD></TR></TABLE>>]; }
}