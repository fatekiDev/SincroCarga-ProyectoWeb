"historial_cumplimiento" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E63CE"><TR><TD COLSPAN="4" BGCOLOR="#8E63CE"><FONT COLOR="white" POINT-SIZE="13"><B>historial_cumplimiento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_historial"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_historial"><B>id_historial</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_historial"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_viaje_id"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="viaje_id">viaje_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_viaje_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tipo_evento"> </TD><TD ALIGN="LEFT" PORT="tipo_evento">tipo_evento</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(50)</FONT></TD><TD PORT="r_tipo_evento"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_descripcion"> </TD><TD ALIGN="LEFT" PORT="descripcion">descripcion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(500)</FONT></TD><TD PORT="r_descripcion"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_evento"> </TD><TD ALIGN="LEFT" PORT="fecha_evento">fecha_evento</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_evento"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: tipo_evento ∈ {Inicio de viaje, Entrega a<BR ALIGN="LEFT"/>&nbsp;&nbsp;tiempo, Entrega completada, Retraso,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Incidencia, Cancelacion}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"match" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>match</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_match"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_match"><B>id_match</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_match"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_postulacion_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="postulacion_id">postulacion_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_postulacion_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_camion_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="camion_id">camion_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_camion_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_chofer_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="chofer_id">chofer_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_chofer_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_match"> </TD><TD ALIGN="LEFT" PORT="fecha_match">fecha_match</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_match"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: estado ∈ {Confirmado, Cancelado,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Completado}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"notificacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E63CE"><TR><TD COLSPAN="4" BGCOLOR="#8E63CE"><FONT COLOR="white" POINT-SIZE="13"><B>notificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_notificacion"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_notificacion"><B>id_notificacion</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_notificacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_cliente_id"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="cliente_id">cliente_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_cliente_id"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_transportista_id"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="transportista_id">transportista_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_transportista_id"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_tipo_notificacion"> </TD><TD ALIGN="LEFT" PORT="tipo_notificacion">tipo_notificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(50)</FONT></TD><TD PORT="r_tipo_notificacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_mensaje"> </TD><TD ALIGN="LEFT" PORT="mensaje">mensaje</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(500)</FONT></TD><TD PORT="r_mensaje"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_envio"> </TD><TD ALIGN="LEFT" PORT="fecha_envio">fecha_envio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_envio"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_leida"> </TD><TD ALIGN="LEFT" PORT="leida">leida</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">boolean</FONT></TD><TD PORT="r_leida"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: (cliente_id ≠ NULL) OR (transportista_id<BR ALIGN="LEFT"/>&nbsp;&nbsp;≠ NULL)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"pago" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>pago</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_pago"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_pago"><B>id_pago</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bigint</FONT></TD><TD PORT="r_id_pago"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_viaje_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="viaje_id">viaje_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_viaje_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_cliente_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="cliente_id">cliente_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_cliente_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tarifa_propuesta"> </TD><TD ALIGN="LEFT" PORT="tarifa_propuesta">tarifa_propuesta</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_tarifa_propuesta"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_comision_porcentaje"> </TD><TD ALIGN="LEFT" PORT="comision_porcentaje">comision_porcentaje</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_comision_porcentaje"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_comision"> </TD><TD ALIGN="LEFT" PORT="comision">comision</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_comision"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_iva_porcentaje"> </TD><TD ALIGN="LEFT" PORT="iva_porcentaje">iva_porcentaje</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_iva_porcentaje"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_iva"> </TD><TD ALIGN="LEFT" PORT="iva">iva</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_iva"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_total_cliente"> </TD><TD ALIGN="LEFT" PORT="total_cliente">total_cliente</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_total_cliente"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_modo"> </TD><TD ALIGN="LEFT" PORT="modo">modo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_modo"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_terminos_aceptados_en"> </TD><TD ALIGN="LEFT" PORT="terminos_aceptados_en">terminos_aceptados_en</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_terminos_aceptados_en"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_creacion"> </TD><TD ALIGN="LEFT" PORT="fecha_creacion">fecha_creacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_creacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_actualizacion"> </TD><TD ALIGN="LEFT" PORT="fecha_actualizacion">fecha_actualizacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_actualizacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_retenido"> </TD><TD ALIGN="LEFT" PORT="fecha_retenido">fecha_retenido</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_retenido"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_liberado"> </TD><TD ALIGN="LEFT" PORT="fecha_liberado">fecha_liberado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_liberado"> </TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: Retenido ⇒ fecha_retenido ≠ NULL;<BR ALIGN="LEFT"/>&nbsp;&nbsp;Liberado ⇒ fecha_liberado ≠ NULL<BR ALIGN="LEFT"/>CHK: total_cliente = tarifa_propuesta +<BR ALIGN="LEFT"/>&nbsp;&nbsp;comision + iva<BR ALIGN="LEFT"/>CHK: comision &gt;= 0<BR ALIGN="LEFT"/>CHK: comision_porcentaje &gt;= 0<BR ALIGN="LEFT"/>CHK: estado ∈ {Procesando, Retenido, Liberado,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Reembolsado, Fallido}<BR ALIGN="LEFT"/>CHK: iva &gt;= 0<BR ALIGN="LEFT"/>CHK: iva_porcentaje &gt;= 0<BR ALIGN="LEFT"/>CHK: (modo)= &#x27;Demostracion&#x27;<BR ALIGN="LEFT"/>CHK: tarifa_propuesta &gt; 0<BR ALIGN="LEFT"/>CHK: total_cliente &gt; 0<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"postulacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>postulacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_postulacion"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_postulacion"><B>id_postulacion</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_postulacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_publicacion_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="publicacion_id">publicacion_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_publicacion_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_transportista_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="transportista_id">transportista_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_transportista_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_postulacion"> </TD><TD ALIGN="LEFT" PORT="fecha_postulacion">fecha_postulacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_postulacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tarifa_propuesta"> </TD><TD ALIGN="LEFT" PORT="tarifa_propuesta">tarifa_propuesta</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_tarifa_propuesta"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_comentario"> </TD><TD ALIGN="LEFT" PORT="comentario">comentario</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(500)</FONT></TD><TD PORT="r_comentario"> </TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">UNIQUE (publicacion_id, transportista_id)<BR ALIGN="LEFT"/>CHK: estado ∈ {Pendiente, Aceptada, Rechazada}<BR ALIGN="LEFT"/>CHK: tarifa_propuesta &gt; 0<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"publicacion_carga" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>publicacion_carga</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_publicacion"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_publicacion"><B>id_publicacion</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_publicacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_carga_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK UQ</B></FONT></TD><TD ALIGN="LEFT" PORT="carga_id">carga_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_carga_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_ruta_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ruta_id">ruta_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_ruta_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_publicacion"> </TD><TD ALIGN="LEFT" PORT="fecha_publicacion">fecha_publicacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_publicacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_limite_postulacion"> </TD><TD ALIGN="LEFT" PORT="fecha_limite_postulacion">fecha_limite_postulacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">date</FONT></TD><TD PORT="r_fecha_limite_postulacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tarifa_ofrecida"> </TD><TD ALIGN="LEFT" PORT="tarifa_ofrecida">tarifa_ofrecida</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_tarifa_ofrecida"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: estado ∈ {Disponible, Asignada, Expirada,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Cancelada}<BR ALIGN="LEFT"/>CHK: fecha_limite_postulacion ≥<BR ALIGN="LEFT"/>&nbsp;&nbsp;fecha_publicacion<BR ALIGN="LEFT"/>CHK: tarifa_ofrecida &gt; 0<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"publicacion_transporte" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#E08A1E"><TR><TD COLSPAN="4" BGCOLOR="#E08A1E"><FONT COLOR="white" POINT-SIZE="13"><B>publicacion_transporte</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_publicacion_transporte"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_publicacion_transporte"><B>id_publicacion_transporte</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_publicacion_transporte"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_transportista_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="transportista_id">transportista_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_transportista_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_camion_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="camion_id">camion_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_camion_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_ruta_id"><FONT POINT-SIZE="9" COLOR="#E08A1E"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="ruta_id">ruta_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_ruta_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_publicacion"> </TD><TD ALIGN="LEFT" PORT="fecha_publicacion">fecha_publicacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_publicacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_disponible_desde"> </TD><TD ALIGN="LEFT" PORT="fecha_disponible_desde">fecha_disponible_desde</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">date</FONT></TD><TD PORT="r_fecha_disponible_desde"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_disponible_hasta"> </TD><TD ALIGN="LEFT" PORT="fecha_disponible_hasta">fecha_disponible_hasta</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">date</FONT></TD><TD PORT="r_fecha_disponible_hasta"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_capacidad_disponible_kg"> </TD><TD ALIGN="LEFT" PORT="capacidad_disponible_kg">capacidad_disponible_kg</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_capacidad_disponible_kg"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_capacidad_disponible_m3"> </TD><TD ALIGN="LEFT" PORT="capacidad_disponible_m3">capacidad_disponible_m3</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_capacidad_disponible_m3"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_tarifa_referencial_ofrecida"> </TD><TD ALIGN="LEFT" PORT="tarifa_referencial_ofrecida">tarifa_referencial_ofrecida</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">numeric</FONT></TD><TD PORT="r_tarifa_referencial_ofrecida"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_estado"> </TD><TD ALIGN="LEFT" PORT="estado">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_estado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">CHK: estado ∈ {Disponible, Reservada,<BR ALIGN="LEFT"/>&nbsp;&nbsp;Expirada, Cancelada}<BR ALIGN="LEFT"/>CHK: fecha_disponible_hasta &gt;<BR ALIGN="LEFT"/>&nbsp;&nbsp;fecha_disponible_desde<BR ALIGN="LEFT"/>CHK: capacidad_disponible_kg &gt; 0<BR ALIGN="LEFT"/>CHK: capacidad_disponible_m3 &gt; 0<BR ALIGN="LEFT"/>CHK: tarifa_referencial_ofrecida &gt;= 0<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"rut_registrado" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#C94F5D"><TR><TD COLSPAN="4" BGCOLOR="#C94F5D"><FONT COLOR="white" POINT-SIZE="13"><B>rut_registrado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_rut_normalizado"><FONT POINT-SIZE="9" COLOR="#C94F5D"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="rut_normalizado"><B>rut_normalizado</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">text</FONT></TD><TD PORT="r_rut_normalizado"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR></TABLE>>];
