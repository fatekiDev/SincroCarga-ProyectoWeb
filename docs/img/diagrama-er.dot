"calificacion" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8E63CE"><TR><TD COLSPAN="4" BGCOLOR="#8E63CE"><FONT COLOR="white" POINT-SIZE="13"><B>calificacion</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_id_calificacion"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>PK</B></FONT></TD><TD ALIGN="LEFT" PORT="id_calificacion"><B>id_calificacion</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_id_calificacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_viaje_id"><FONT POINT-SIZE="9" COLOR="#8E63CE"><B>FK</B></FONT></TD><TD ALIGN="LEFT" PORT="viaje_id">viaje_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_viaje_id"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_emisor"> </TD><TD ALIGN="LEFT" PORT="emisor">emisor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(20)</FONT></TD><TD PORT="r_emisor"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_puntaje"> </TD><TD ALIGN="LEFT" PORT="puntaje">puntaje</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">integer</FONT></TD><TD PORT="r_puntaje"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="l_comentario"> </TD><TD ALIGN="LEFT" PORT="comentario">comentario</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">varchar(500)</FONT></TD><TD PORT="r_comentario"> </TD></TR><TR><TD ALIGN="LEFT" PORT="l_fecha_calificacion"> </TD><TD ALIGN="LEFT" PORT="fecha_calificacion">fecha_calificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamp</FONT></TD><TD PORT="r_fecha_calificacion"><FONT POINT-SIZE="8" COLOR="#999999">NN</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#F6F6F6"><FONT POINT-SIZE="8" COLOR="#333333">UNIQUE IDX (viaje_id, emisor)<BR ALIGN="LEFT"/>CHK: (puntaje &gt;= 1) AND (puntaje &lt;= 5)<BR ALIGN="LEF